@template
def FirefoxBranding():
    JS_PREFERENCE_FILES += [
        'pref/firefox-branding.js',
    ]
    JS_PREFERENCE_PP_FILES += [
        'pref/uaoverrides.inc',
    ]

    if 'gtk' in CONFIG['MOZ_WIDGET_TOOLKIT']:
        FINAL_TARGET_FILES.chrome.icons.default += [
            'default128.png',
            'default16.png',
            'default32.png',
            'default48.png',
            'default64.png',
        ]
